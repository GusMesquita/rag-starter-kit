ANTHROPIC_API_KEY=
CHROMA_PATH=./chroma_data
COLLECTION_NAME=documents
TOP_K=4

# dev libera rodar sem API_KEYS; prod exige (o app não sobe sem chave).
ENVIRONMENT=dev

# Comma-separated shared secrets for the X-API-Key header. Obrigatório quando
# ENVIRONMENT=prod.
API_KEYS=

# Origens liberadas no CORS, separadas por vírgula. Vazio = nenhuma.
CORS_ORIGINS=http://localhost:5173

# 0 desliga o rate limit (só em dev).
RATE_LIMIT_PER_MINUTE=60

# Teto do corpo do POST /ingest, em bytes.
MAX_INGEST_BYTES=1000000
